PORT=4000

# Solo se usa cuando arranques Chatwoot con: npm run start:chatwoot
CHATWOOT_URL=http://127.0.0.1:3000/api/v1
CHATWOOT_BOT_TOKEN=
BOT_DISABLED_LABELS=sucursales
BOT_DISABLED_PHONES=

# Requerido para pruebas de flujo con WhatsApp Web y para Chatwoot.
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_DATABASE=
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000

SUCURSALES_DATA_URL=https://raw.githubusercontent.com/napoles-desarrollo/sucursales/refs/heads/main/listasucursales.json
CHATBOT_FLOW_PATH=src/data/chatbot-flow.json
BOT_ASSISTANT_NAME=Napo
# Una sola base de shapefile. Puede ser carpeta o prefijo sin extension.
CP_SHAPEFILE_BASE=src/utils/CP_Tab/CP_Tab
# Para varios estados, separar por coma o punto y coma.
# CP_SHAPEFILE_BASES=src/utils/CP_Tab/CP_Tab,src/utils/CP_Chis/CP_Chis,src/utils/CP_Ver/CP_Ver
TOP_STUDIES_FROM=2026-01-01
TOP_STUDIES_LIMIT=5

PORTAL_SALUD_URL=https://portal.labnapoles.mx
API_BASE_URL=
API_TOKEN=

# Opcional para pruebas con WhatsApp Web/Puppeteer.
WA_HEADLESS=true
PUPPETEER_EXECUTABLE_PATH=

# Audio/nota de voz en WhatsApp Web.
AUDIO_TRANSCRIPTION_ENABLED=true
FFMPEG_PATH=ffmpeg
WHISPER_CLI_PATH=~/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=~/whisper.cpp/models/ggml-small.bin
WHISPER_LANGUAGE=es
WHISPER_INITIAL_PROMPT=Chatbot de Laboratorios Napoles en espanol mexicano. Opciones frecuentes: Villahermosa, Villa Jalupa, Nacajuca Laboratorio, cotizar servicios, consultar resultados, direcciones y horarios, hablar con asesor.
WHISPER_TIMEOUT_MS=120000
MEDIA_TEMP_DIR=tmp/media
MEDIA_KEEP_FILES=false

# ── Clasificador de intenciones con Ollama (opcional) ────────────────────────
# Solo se consulta cuando los patrones deterministas NO reconocieron el mensaje.
# Con NLU_ENABLED=false el bot funciona exactamente igual que antes.
NLU_ENABLED=false
# sombra = clasifica y lo registra en el log, pero NO decide (para comparar antes de soltarlo)
# activo = la IA puede redirigir la conversacion
NLU_MODO=sombra
# Si Ollama corre en otra maquina: OLLAMA_HOST=0.0.0.0 en ese equipo y aqui su IP.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# Sin keep_alive Ollama descarga el modelo a los 5 min y la siguiente consulta
# paga la recarga completa (~5 GB), muy por encima del timeout.
OLLAMA_KEEP_ALIVE=30m
NLU_TIMEOUT_MS=10000
NLU_NUM_CTX=2048
NLU_NUM_PREDICT=100
NLU_SIN_RAZONAMIENTO=true
NLU_FALLOS_PARA_ABRIR=3
NLU_REPOSO_MS=60000
NLU_CACHE=500
NLU_PRECALENTAR=true
